# No key is needed for deterministic demo mode.
AML_AGENT_MODE=demo
# For OpenAI: set mode to openai, then supply your key and an enabled model ID.
OPENAI_API_KEY=
AML_OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
# Set an Anthropic model ID available to your account when using claude mode.
AML_CLAUDE_MODEL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aml-investigation-poc
# Optional: choose a different API address for the console.
AML_API_URL=http://127.0.0.1:8001

# Optional Gmail RFI. Leave SMTP_PASSWORD empty to record the request without sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jkanuku0305@gmail.com
SMTP_FROM=jkanuku0305@gmail.com
SMTP_TO=jkanuku0305@gmail.com
SMTP_PASSWORD=

# Required RDS PostgreSQL connection. Customers, accounts, counterparties,
# policy thresholds and transactions are read from these tables on every start.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# Writable schema for alerts, cases, documents, audit and LangGraph checkpoints.
# Use a new schema if you want a clean two-customer demo run.
AML_APP_SCHEMA=aml_app
# Primary demo path: Monitoring Start posts the Casa Brisa episode-3 packet in-app.
# Backup: run aml_poc/fixtures/live_casa_brisa.sql in RDS; rewind with reset_live_casa_brisa.sql.
# The API can also watch TXN-LIVE-C002-* from RDS. Set AML_LIVE_WATCH=0 only in tests.
# AML_LIVE_WATCH=1
# Optional stream split. Default: replay the most recent 1,000 RDS transactions.
# AML_STREAM_START=2026-08-01T00:00:00
# AML_STREAM_EVENTS=1000
