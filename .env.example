# No key is needed for deterministic demo mode.
AML_AGENT_MODE=demo
# For OpenAI: set mode to openai, then supply your key and an enabled model ID.
OPENAI_API_KEY=
AML_OPENAI_MODEL=gpt-5-mini
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aml-investigation-poc
# Optional: choose a different API address for the console.
AML_API_URL=http://127.0.0.1:8001

# Required RDS PostgreSQL connection. Customers, accounts, counterparties,
# policy thresholds and transactions are read from these tables on every start.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# Writable schema for alerts, cases, documents, audit and LangGraph checkpoints.
AML_APP_SCHEMA=aml_app
# Optional stream split. Default: replay the most recent 1,000 RDS transactions.
# AML_STREAM_START=2026-08-01T00:00:00
# AML_STREAM_EVENTS=1000
